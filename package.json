{
  "name": "@ttkit/daily-hot-api",
  "version": "0.1.3",
  "description": "一个基于 NestJS 的每日热榜聚合 API 服务，支持多个平台的热榜数据获取，支持本地部署、pm2部署、docker部署，并提供可全局安装的 CLI 启动/停止热点服务。",
  "author": "Helti",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelTi/daily-hot-api.git"
  },
  "homepage": "https://helti.github.io/daily-hot-api/",
  "bugs": {
    "url": "https://github.com/HelTi/daily-hot-api/issues"
  },
  "keywords": [
    "daily-hot",
    "hot-list",
    "hot-search",
    "nestjs",
    "api",
    "cli",
    "aggregator",
    "weibo",
    "zhihu",
    "bilibili",
    "mongo",
    "redis"
  ],
  "bin": {
    "daily-hot-api": "bin/daily-hot-api.js"
  },
  "main": "dist/main.js",
  "files": [
    "bin/",
    "dist/",
    "views/",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "cli": "node bin/daily-hot-api.js",
    "prepublishOnly": "npm run build",
    "pack:check": "npm pack --dry-run",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:skill": "node --test test/skill/*.test.mjs",
    "test:cli": "node test/cli/lifecycle-smoke.mjs",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.0.0",
    "cache-manager": "^7.1.0",
    "cheerio": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dayjs": "^1.11.13",
    "dotenv": "^16.5.0",
    "hbs": "^4.2.0",
    "iconv-lite": "^0.6.3",
    "ioredis": "^5.6.1",
    "md5": "^2.3.0",
    "mongoose": "^7.6.3",
    "openai": "^4.104.0",
    "reflect-metadata": "^0.2.2",
    "rss": "^1.2.2",
    "rss-parser": "^3.13.0",
    "rxjs": "^7.8.1",
    "user-agents": "^1.1.542",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/cheerio": "^1.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/md5": "^2.3.5",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@types/ua-parser-js": "^0.7.39",
    "@types/user-agents": "^1.0.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitepress": "^1.6.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
