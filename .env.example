# 复制为 .env 后使用。
# 通过 npm CLI（daily-hot-api）启动时会默认读取当前工作目录的 .env，
# 也可以用 --config 指定其他配置文件；完整变量说明见 https://helti.github.io/daily-hot-api/reference/environment-variables 。

PORT=6689
# 监听地址。默认 0.0.0.0（所有网卡）；只给本机或反向代理用时设 127.0.0.1
HOST="0.0.0.0"
# 允许的域名
ALLOWED_DOMAIN="*"

# Redis
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# mongodb
MONGODB_URI=mongodb://localhost:27017/daily-hot-api

# 缓存时长（ 秒 ）
CACHE_TTL=3600

# 请求超时（ 毫秒 ）
REQUEST_TIMEOUT=6000

# RSS Mode
RSS_MODE=false

# 不允许用户手动刷新的源名称,如github频繁请求会被屏蔽，使用,隔开
NOT_ALLOWED_REFRESH_SOURCE=github,bilibili

# 忽略保存的数据源（用逗号分隔，如：v2ex,github,hostloc）
# 这些数据源的数据不会被保存到数据库中，但仍然可以通过API获取实时数据
IGNORE_SAVE_SOURCES=v2ex,nodeseek,nytimes,linuxdo,producthunt,hostloc,github

# 启用定时任务自动启动（默认不启动）
SCHEDULER_AUTO_START=false

# 定时任务触发时间
SCHEDULER_CRON_EXPRESSION=0 */12 * * *

# 每日简报配置
BRIEF_ENABLED=false
BRIEF_CRON_EXPRESSION=0 12 * * *
BRIEF_TIMEZONE=Asia/Shanghai
BRIEF_SOURCES=cls,yicai,wallstreet,jin10,tonghuashun,eastmoney,gelonghui
BRIEF_LOOKBACK_HOURS=24
BRIEF_TOP_ITEMS_PER_SOURCE=10
BRIEF_MAX_TOPICS=12
# 股票历史排名接口缓存时长（秒，默认 12 小时）
BRIEF_STOCK_RANKING_CACHE_TTL=43200
# 简报卡在 generating 状态多久后视为失败并允许重新生成（分钟）
BRIEF_GENERATING_TIMEOUT_MINUTES=30
# 抓取热榜源时的最大并发数
BRIEF_SOURCE_CONCURRENCY=3
# 搜索增强的最大并发数（每个主题按平台顺序依次尝试）
BRIEF_SEARCH_CONCURRENCY=3
# 搜索平台优先级，逗号分隔；可选 tavily、deepseek；留空关闭搜索增强
BRIEF_SEARCH_PROVIDERS=tavily,deepseek

# 通用新闻简报配置（独立 collection / 调度器 / 配置前缀；前端只读）
# 板块：finance 财经、general 综合新闻、tech 科技、sports 体育
NEWS_BRIEF_ENABLED=false
NEWS_BRIEF_CRON_EXPRESSION=30 8 * * *
NEWS_BRIEF_TIMEZONE=Asia/Shanghai
NEWS_BRIEF_CATEGORIES=finance,general,tech,sports
NEWS_BRIEF_LOOKBACK_HOURS=24
NEWS_BRIEF_TOP_ITEMS_PER_SOURCE=8
NEWS_BRIEF_MAX_CANDIDATES=40
NEWS_BRIEF_MAX_ITEMS_PER_CATEGORY=8
NEWS_BRIEF_SOURCE_CONCURRENCY=3
NEWS_BRIEF_CATEGORY_CONCURRENCY=1
NEWS_BRIEF_GENERATING_TIMEOUT_MINUTES=30
# 手动生成接口默认禁用：前端不允许触发；运维需要时临时设为 true 再重启
NEWS_BRIEF_MANUAL_GENERATE_ENABLED=false
# P1 搜索增强（默认关闭；开启后为候选新闻补充搜索证据，会产生搜索费用）
NEWS_BRIEF_SEARCH_ENABLED=false
NEWS_BRIEF_SEARCH_MAX_QUERIES=6
NEWS_BRIEF_SEARCH_CONCURRENCY=3
# 单条搜索词最大字符数（产品要求 2000 字以内）
NEWS_BRIEF_SEARCH_QUERY_MAX_CHARS=2000
# 搜索平台优先级，逗号分隔；可选 tavily、deepseek；留空关闭搜索增强
NEWS_BRIEF_SEARCH_PROVIDERS=tavily,deepseek

# OPENAI 配置
OPENAI_API_KEY=skxxx
OPENAI_API_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
# 单次 AI 请求超时（毫秒）与重试次数
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=2

# Tavily Search API Key
# 从 https://tavily.com 获取你的API Key
TAVILY_API_KEY=tvly-dev-xxx
TAVILY_MAX_RESULTS=5
# 单次 Tavily 搜索超时（毫秒）
TAVILY_TIMEOUT_MS=10000

# DeepSeek Search API Key（可使用与 DeepSeek 模型相同的 Key）
DEEPSEEK_SEARCH_API_KEY=
DEEPSEEK_SEARCH_MAX_RESULTS=5
# 单次 DeepSeek 网页搜索超时（毫秒）
DEEPSEEK_SEARCH_TIMEOUT_MS=10000
